#!/bin/bash
# AI 对话台启动器（双击运行，无需修改本文件）
# 路径: Contents/MacOS/启动 -> 往上三层到 AI起步 目录
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"

# 挑一个「图形引擎(Tk)够新」的 Python。
# 系统自带的 /usr/bin/python3 是 Tk 8.5，在 macOS 上会画出「窗口在、内容空」的毛病，
# 必须避开；Tk 8.6 及以上才正常。
CANDIDATES=(
  "$HOME/.workbuddy/binaries/python/versions/3.13.12/bin/python3"
  "$HOME/llm-lab/venv-m4/bin/python"
  "$(command -v python3 2>/dev/null)"
  /usr/bin/python3
)
PY=""
for c in "${CANDIDATES[@]}"; do
  [ -n "$c" ] || continue
  [ -x "$c" ] || continue
  if "$c" -c 'import tkinter,sys; sys.exit(0 if tkinter.TkVersion>=8.6 else 1)' 2>/dev/null; then
    PY="$c"
    break
  fi
done
[ -n "$PY" ] || PY=/usr/bin/python3

exec "$PY" "$DIR/AI对话台.app.py"
